{
  "schemaVersion": 1,
  "id": "wei.omarpets",
  "name": "OmaPets",
  "version": "0.2.1",
  "author": "OmaPets contributors",
  "license": "MIT",
  "description": "An animated Codex-compatible pet that reflects coding-agent activity in the Omarchy top bar.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Main.qml"
  },
  "barWidget": {
    "displayName": "OmaPets",
    "description": "A Codex-compatible animated pet for idle, working, waiting, success, and error states.",
    "category": "AI",
    "aliases": ["pet", "agent-pet", "codex-pet"],
    "allowMultiple": false,
    "defaults": {
      "petPath": "",
      "scale": 0.8,
      "frameIntervalMs": 140,
      "autoDetect": true,
      "activeWindowSec": 8
    },
    "schema": [
      { "key": "petPath", "type": "path", "label": "Pet folder or ID", "defaultValue": "", "description": "Pet ID in ~/.config/omarpets/pets, or a folder containing pet.json and its spritesheet." },
      { "key": "scale", "type": "number", "label": "Pet scale", "min": 0.5, "max": 2.5, "step": 0.05, "defaultValue": 0.8 },
      { "key": "frameIntervalMs", "type": "integer", "label": "Frame interval (ms)", "min": 60, "max": 500, "step": 10, "defaultValue": 140 },
      { "key": "autoDetect", "type": "boolean", "label": "Detect Codex and Claude", "defaultValue": true },
      { "key": "activeWindowSec", "type": "integer", "label": "Recent activity window (seconds)", "min": 2, "max": 60, "step": 1, "defaultValue": 8 }
    ]
  }
}
