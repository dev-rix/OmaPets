#!/usr/bin/env bash
set -uo pipefail

readonly MAX_FILE_BYTES=$((50 * 1024 * 1024))
readonly MAX_REDIRECTS=5
readonly PETDEX_HOSTS="petdex.dev www.petdex.dev petdex.crafter.run assets.petdex.dev"
readonly CODEX_PETS_HOSTS="codex-pets.net www.codex-pets.net"
readonly OPENPETS_HOSTS="openpets.dev www.openpets.dev"
readonly PETDEX_MANIFEST_URL="${OMAPETS_PETDEX_MANIFEST_URL:-https://petdex.dev/api/manifest}"
readonly CODEX_PETS_API_BASE="${OMAPETS_CODEX_PETS_API_BASE:-https://codex-pets.net/api/pets}"
readonly OPENPETS_SEARCH_INDEX_URL="${OMAPETS_OPENPETS_SEARCH_INDEX_URL:-https://openpets.dev/pets/catalog.v3/search.json}"

script_dir=$(cd -- "$(dirname -- "$0")" && pwd)
interactive=0
temp_root=

usage() {
  cat <<'EOF'
Usage:
  omapets
  omapets <pet-url> [--dir <pets-directory>]
  omapets install <pet-url> [--dir <pets-directory>]

Examples:
  omapets https://petdex.dev/pets/kabi
  omapets 'https://codex-pets.net/#/pets/dario'
  omapets https://openpets.dev/pets/player-05-b28eec8e
EOF
}

interactive_help() {
  cat <<'EOF'
Install a pet

Paste a pet page URL from one of these providers:
  Petdex:      https://petdex.dev/pets/<pet-id>
  Codex Pets:  https://codex-pets.net/#/pets/<pet-id>
  OpenPets:    https://openpets.dev/pets/<pet-id>

The pet will be installed in ~/.config/omapets/pets.
EOF
}

fail() {
  printf 'omapets: %s\n' "$*" >&2
  return 1
}

log() {
  printf '[omapets] %s\n' "$*"
}

cleanup() {
  [[ -n ${temp_root:-} ]] && rm -rf -- "$temp_root"
}
trap cleanup EXIT

url_host() {
  local url=$1 authority host port
  [[ $url == https://* ]] || return 1
  authority=${url#https://}
  authority=${authority%%[/?#]*}
  [[ -n $authority && $authority != *@* && $authority != \[* ]] || return 1
  host=${authority%%:*}
  port=${authority#"$host"}
  [[ -z $port || $port == :443 ]] || return 1
  printf '%s' "${host,,}"
}

host_allowed() {
  local needle=$1 allowed=$2 host
  for host in $allowed; do
    [[ $needle == "$host" ]] && return 0
  done
  return 1
}

validate_download_url() {
  local url=$1 allowed=$2 host
  host=$(url_host "$url") || { fail "Download URL must use HTTPS on port 443 without credentials: $url"; return 1; }
  host_allowed "$host" "$allowed" || { fail "Download URL uses an unapproved host: $host"; return 1; }
}

resolve_redirect() {
  local base=$1 location=$2 host rest path directory
  if [[ $location == https://* ]]; then
    printf '%s' "$location"
  elif [[ $location == /* && $location != //* ]]; then
    host=$(url_host "$base") || return 1
    printf 'https://%s%s' "$host" "$location"
  elif [[ $location != *://* && $location != //* && $location != *\?* && $location != *\#* ]]; then
    host=$(url_host "$base") || return 1
    rest=${base#https://}; path=/${rest#*/}; directory=${path%/*}
    path=$(realpath -m -- "$directory/$location") || return 1
    printf 'https://%s%s' "$host" "$path"
  else
    return 1
  fi
}

safe_fetch() {
  local url=$1 allowed=$2 output=$3 redirects=0 status location next headers body size
  headers="$temp_root/headers"
  body="$temp_root/body"

  while :; do
    validate_download_url "$url" "$allowed" || return 1
    log "Fetching $url"
    : >"$headers"
    status=$(curl --silent --show-error --proto '=https' --max-filesize "$MAX_FILE_BYTES" \
      --dump-header "$headers" --output "$body" --write-out '%{http_code}' -- "$url") \
      || { fail "Download failed for $url"; return 1; }

    case "$status" in
      301|302|303|307|308)
        (( redirects < MAX_REDIRECTS )) || { fail "Download exceeded $MAX_REDIRECTS redirects"; return 1; }
        location=$(awk 'BEGIN { IGNORECASE=1 } /^Location:/ { sub(/^[^:]*:[[:space:]]*/, ""); sub(/\r$/, ""); value=$0 } END { print value }' "$headers")
        [[ -n $location ]] || { fail "Redirect is missing a Location header: $url"; return 1; }
        next=$(resolve_redirect "$url" "$location") \
          || { fail "Redirect must use an absolute HTTPS URL or an absolute path: $location"; return 1; }
        log "Following redirect $status to $next"
        url=$next
        ((redirects++))
        ;;
      2??)
        size=$(stat -c %s "$body") || return 1
        (( size > 0 )) || { fail "Downloaded an empty file from $url"; return 1; }
        (( size <= MAX_FILE_BYTES )) || { fail "Download is larger than $MAX_FILE_BYTES bytes"; return 1; }
        mv -f -- "$body" "$output"
        return 0
        ;;
      *) fail "Download failed ($status) for $url"; return 1 ;;
    esac
  done
}

parse_pet_source() {
  local url=$1 host route
  host=$(url_host "$url") || { fail "Pet URL must use HTTPS on petdex.dev, codex-pets.net, or openpets.dev"; return 1; }

  case "$host" in
    codex-pets.net|www.codex-pets.net)
      [[ $url =~ ^https://(www\.)?codex-pets\.net(:443)?/\#/pets/([a-z0-9]+(-[a-z0-9]+)*)/?$ ]] \
        || { fail "Pet URL must look like https://codex-pets.net/#/pets/<pet-id>"; return 1; }
      provider=codex-pets; slug=${BASH_REMATCH[3]}
      ;;
    openpets.dev|www.openpets.dev)
      [[ $url =~ ^https://(www\.)?openpets\.dev(:443)?/pets/([a-z0-9]+(-[a-z0-9]+)*)/?$ ]] \
        || { fail "Pet URL must look like https://openpets.dev/pets/<pet-id>"; return 1; }
      provider=openpets; slug=${BASH_REMATCH[3]}
      ;;
    petdex.dev|www.petdex.dev|petdex.crafter.run)
      route=${url#https://}; route=/${route#*/}
      [[ $route =~ ^/([^/]+/)?pets/([a-z0-9]+(-[a-z0-9]+)*)/?$ ]] \
        || { fail "Pet URL must look like https://petdex.dev/pets/<pet-id>"; return 1; }
      provider=petdex; slug=${BASH_REMATCH[2]}
      ;;
    *) fail "Pet URL must use HTTPS on petdex.dev, codex-pets.net, or openpets.dev"; return 1 ;;
  esac
}

install_petdex() {
  local manifest=$1 pet_json=$2 spritesheet=$3 fields pet_json_url spritesheet_url
  log "Loading Petdex manifest"
  safe_fetch "$PETDEX_MANIFEST_URL" "$PETDEX_HOSTS" "$manifest" || return 1
  fields=$(jq -er --arg slug "$slug" '
    (.pets? // .) as $entries
    | select($entries | type == "array")
    | first($entries[] | select(.slug == $slug))
    | select(.petJsonUrl and .spritesheetUrl)
    | [.petJsonUrl, .spritesheetUrl] | @tsv
  ' "$manifest") || { fail "Petdex pet not found or manifest entry is incomplete: $slug"; return 1; }
  IFS=$'\t' read -r pet_json_url spritesheet_url <<<"$fields"
  safe_fetch "$pet_json_url" "$PETDEX_HOSTS" "$pet_json" || return 1
  safe_fetch "$spritesheet_url" "$PETDEX_HOSTS" "$spritesheet" || return 1
}

install_codex_pets() {
  local detail=$1 pet_json=$2 spritesheet=$3 spritesheet_url
  log "Loading Codex Pets metadata"
  safe_fetch "${CODEX_PETS_API_BASE%/}/$slug" "$CODEX_PETS_HOSTS" "$detail" || return 1
  spritesheet_url=$(jq -er '.pet | select(.spritesheetUrl) | .spritesheetUrl' "$detail") \
    || { fail "Codex Pets returned incomplete metadata: $slug"; return 1; }
  jq -e '.pet' "$detail" >"$pet_json" || return 1
  safe_fetch "$spritesheet_url" "$CODEX_PETS_HOSTS" "$spritesheet" || return 1
}

install_openpets() {
  local index=$1 pet_json=$2 spritesheet=$3 pet_id pages page_url page_file catalog_page catalog_url catalog pet spritesheet_url
  [[ $slug =~ ^(.+)-[0-9a-f]{8}$ ]] \
    || { fail "OpenPets URL must end with its eight-character page fingerprint"; return 1; }
  pet_id=${BASH_REMATCH[1]}
  log "Searching the OpenPets catalog"
  safe_fetch "$OPENPETS_SEARCH_INDEX_URL" "$OPENPETS_HOSTS" "$index" || return 1
  mapfile -t pages < <(jq -er 'select(.version == 3 and (.pages | type == "array")) | .pages[]' "$index")
  (( ${#pages[@]} > 0 )) || { fail "OpenPets returned an invalid search index"; return 1; }

  catalog_page=
  for page_url in "${pages[@]}"; do
    page_url=$(resolve_redirect "$OPENPETS_SEARCH_INDEX_URL" "$page_url") \
      || { fail "OpenPets search page uses an invalid URL: $page_url"; return 1; }
    page_file="$temp_root/search-page.json"
    safe_fetch "$page_url" "$OPENPETS_HOSTS" "$page_file" || return 1
    catalog_page=$(jq -er --arg id "$pet_id" 'first(.pets[]? | select(.id == $id) | .catalogPage) // empty' "$page_file") || true
    [[ $catalog_page =~ ^[0-9]+$ ]] && break
  done
  [[ $catalog_page =~ ^[0-9]+$ ]] || { fail "OpenPets pet not found: $slug"; return 1; }

  printf -v catalog_url 'https://openpets.dev/pets/catalog.v3/page-%03d.json' "$catalog_page"
  catalog="$temp_root/catalog.json"
  safe_fetch "$catalog_url" "$OPENPETS_HOSTS" "$catalog" || return 1
  pet=$(jq -cer --arg id "$pet_id" 'first(.pets[]? | select(.id == $id and .spritesheet)) // empty' "$catalog") \
    || { fail "OpenPets catalog entry is incomplete: $pet_id"; return 1; }
  spritesheet_url=$(jq -r '.spritesheet' <<<"$pet")
  [[ $spritesheet_url == "https://openpets.dev/pets/$slug/spritesheet.webp" \
      || $spritesheet_url == "https://www.openpets.dev/pets/$slug/spritesheet.webp" ]] \
    || { fail "OpenPets catalog returned an unexpected spritesheet URL"; return 1; }
  jq -n --arg id "$pet_id" --arg name "$(jq -r '.displayName // empty' <<<"$pet")" \
    --arg description "$(jq -r '.description // empty' <<<"$pet")" \
    '{id:$id, displayName:(if $name == "" then $id else $name end), description:$description, spritesheetPath:"spritesheet.webp"}' >"$pet_json"
  safe_fetch "$spritesheet_url" "$OPENPETS_HOSTS" "$spritesheet" || return 1
}

normalize_id() {
  local value=$1 normalized
  if command -v iconv >/dev/null; then
    normalized=$(printf '%s' "$value" | iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null || printf '%s' "$value")
  else
    normalized=$value
  fi
  normalized=$(printf '%s' "$normalized" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
  printf '%s' "${normalized:-$slug}"
}

install_pet() {
  local pet_url=$1 pets_dir=$2 manifest detail pet_json downloaded_sheet pet_id sheet_path installed_slug destination staging display_name
  parse_pet_source "$pet_url" || return 1
  log "Installing $provider pet $slug"
  mkdir -p -- "$pets_dir" || return 1
  temp_root=$(mktemp -d "${TMPDIR:-/tmp}/omarpets.XXXXXX") || return 1
  manifest="$temp_root/manifest.json"; detail="$temp_root/detail.json"
  pet_json="$temp_root/pet.json"; downloaded_sheet="$temp_root/spritesheet"

  case "$provider" in
    petdex) install_petdex "$manifest" "$pet_json" "$downloaded_sheet" || return 1 ;;
    codex-pets) install_codex_pets "$detail" "$pet_json" "$downloaded_sheet" || return 1 ;;
    openpets) install_openpets "$manifest" "$pet_json" "$downloaded_sheet" || return 1 ;;
  esac

  log "Validating downloaded pet package"
  jq -e . "$pet_json" >/dev/null 2>&1 || { fail "Pet provider returned an invalid pet.json"; return 1; }
  pet_id=$(jq -er '.id | strings | select(length > 0)' "$pet_json") \
    || { fail "pet.json must include an ID"; return 1; }
  sheet_path=$(jq -er '.spritesheetPath | strings' "$pet_json") || true
  [[ $sheet_path =~ ^spritesheet\.(webp|png)$ ]] \
    || { fail "pet.json must reference spritesheet.webp or spritesheet.png"; return 1; }
  installed_slug=$(normalize_id "$pet_id")
  destination="${pets_dir%/}/$installed_slug"
  [[ ! -e $destination ]] || { fail "Pet is already installed: $destination"; return 1; }

  staging=$(mktemp -d "${pets_dir%/}/.${slug}.XXXXXX") || return 1
  log "Writing pet files to $destination"
  cp -- "$pet_json" "$staging/pet.json" || { rm -rf -- "$staging"; return 1; }
  cp -- "$downloaded_sheet" "$staging/$sheet_path" || { rm -rf -- "$staging"; return 1; }
  mv -- "$staging" "$destination" || { rm -rf -- "$staging"; fail "Could not install pet at $destination"; return 1; }

  display_name=$(jq -r '.displayName // .id' "$pet_json")
  printf 'Installed %s to %s\n' "$display_name" "$destination"
}

main() {
  local pet_url= pets_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omapets/pets"
  command -v curl >/dev/null || { fail "curl is required"; return 1; }
  command -v jq >/dev/null || { fail "jq is required"; return 1; }
  [[ ${1:-} == install ]] && shift
  if [[ ${1:-} == -h || ${1:-} == --help ]]; then usage; return 0; fi
  if [[ $# -gt 0 && ${1:-} != --dir ]]; then pet_url=$1; shift; fi
  while (( $# > 0 )); do
    case "$1" in
      --dir) [[ $# -ge 2 ]] || { fail "--dir requires a directory"; return 1; }; pets_dir=$2; shift 2 ;;
      *) fail "Unknown option: $1"; usage >&2; return 1 ;;
    esac
  done

  if [[ -z $pet_url ]]; then
    [[ -t 0 && -t 1 ]] || { fail "A Petdex, Codex Pets, or OpenPets URL is required"; return 1; }
    interactive=1
    clear
    printf '\033[32m'; cat "$script_dir/../assets/logo.txt"; printf '\033[0m\n'
    interactive_help
    printf '\nPet URL: '
    IFS= read -r pet_url
    [[ -n $pet_url ]] || { fail "A pet URL is required"; return 1; }
  fi

  install_pet "$pet_url" "$pets_dir"
}

main "$@"
status=$?
if (( interactive )); then
  command -v omarchy >/dev/null && omarchy shell -q omapets refreshPets || true
  printf '\nPress any key to close…'
  IFS= read -r -n 1 -s || true
  printf '\n'
fi
exit "$status"
