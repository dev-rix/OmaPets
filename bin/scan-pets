#!/usr/bin/env bash
set -euo pipefail

pets_dir="${1:?pets directory is required}"
previews_dir="${2:?previews directory is required}"

mkdir -p "$previews_dir"
[[ -d "$pets_dir" ]] || exit 0

find "$pets_dir" -mindepth 2 -maxdepth 2 -type f -name pet.json -printf '%h\n' 2>/dev/null \
  | sort \
  | while IFS= read -r pet_dir; do
      id="${pet_dir##*/}"
      sheet=$(jq -r '.spritesheetPath // empty' "$pet_dir/pet.json" 2>/dev/null || true)
      [[ -n "$sheet" && -f "$pet_dir/$sheet" ]] || continue

      preview="$previews_dir/$id.png"
      if [[ ! -f "$preview" || "$pet_dir/$sheet" -nt "$preview" ]]; then
        magick "$pet_dir/$sheet" "$preview" || continue
      fi

      name=$(jq -r '(.displayName // .id // "") | tostring | gsub("[\u0000-\u001f\u007f]"; " ")' \
        "$pet_dir/pet.json" 2>/dev/null || true)
      [[ -n "$name" ]] || name="$id"
      rows=$(jq -r 'if (((.spriteVersionNumber | tonumber?) // 1) >= 2) then 11 else 9 end' \
        "$pet_dir/pet.json" 2>/dev/null || printf 9)
      [[ $rows == 11 ]] || rows=9
      printf '%s\t%s\t%s\t%s\n' "$id" "$name" "$sheet" "$rows"
    done
