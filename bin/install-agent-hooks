#!/usr/bin/env bash
set -euo pipefail

# With no agent arguments, operate on every supported agent.
supported=(codex claude opencode gemini copilot crush grok pi omp)
action=install
interactive=0
if [[ ${1:-} == --interactive ]]; then
  interactive=1
  shift
fi
if [[ ${1:-} == --uninstall || ${1:-} == uninstall ]]; then
  action=uninstall
  shift
elif [[ ${1:-} == --install || ${1:-} == install ]]; then
  shift
fi
targets=("${@:-all}")
script_dir=$(cd -- "$(dirname -- "$0")" && pwd)
installed_hook="$HOME/.config/omarchy/plugins/omapets/bin/omapets-hook"
if [[ -x $installed_hook ]]; then
  hook_command="$installed_hook"
else
  hook_command="$script_dir/omapets-hook"
fi

choose_interactive_targets() {
  local selection
  command -v gum >/dev/null || { printf 'gum is required for interactive hook installation\n' >&2; return 1; }
  clear 2>/dev/null || true
  printf '\033[32m'; cat "$script_dir/../assets/logo.txt"; printf '\033[0m\n'
  cat <<'EOF'
Install agent hooks

Choose the coding agents that should report their activity to OmaPets.
Use Space to select one or more agents, then press Enter to install.

EOF
  selection=$(printf '%s\n' "${supported[@]}" \
    | gum choose --no-limit --height 12 --header "Select agents") || return 130
  [[ -n $selection ]] || return 130
  mapfile -t targets <<<"$selection"
}

finish_interactive() {
  local status=$1
  if (( status == 0 )); then
    printf '\nAgent hooks installed. Restart open agent sessions to activate them.\n'
  elif (( status == 130 )); then
    printf '\nInstallation cancelled.\n'
  else
    printf '\nOne or more agent hooks could not be installed.\n'
  fi
  printf '\nPress any key to close…'
  IFS= read -r -n 1 -s || true
  printf '\n'
}

reject_unsafe_target() {
  local target=$1
  if [[ -L $target ]]; then
    printf 'Refusing symlink target: %s\n' "$target" >&2
    return 1
  fi
  if [[ -e $target && ! -f $target ]]; then
    printf 'Refusing non-regular target: %s\n' "$target" >&2
    return 1
  fi
}

random_sibling() {
  local target=$1 kind=$2 suffix
  suffix=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
  printf '%s/.%s.%s.%s' "$(dirname -- "$target")" "$(basename -- "$target")" "$kind" "$suffix"
}

write_exclusive() {
  local path=$1
  perl -MFcntl=:DEFAULT -e '
    use strict; use warnings;
    my ($path) = @ARGV;
    sysopen(my $out, $path, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600)
      or die "Refusing to create $path: $!\n";
    my $buffer;
    while (read(STDIN, $buffer, 65536)) { print {$out} $buffer or die "write $path: $!\n"; }
    close($out) or die "close $path: $!\n";
  ' "$path"
}

copy_nofollow() {
  local source=$1 destination=$2
  perl -MFcntl=:DEFAULT -e '
    use strict; use warnings;
    my ($source, $destination) = @ARGV;
    sysopen(my $in, $source, O_RDONLY | O_NOFOLLOW)
      or die "Refusing to read $source: $!\n";
    sysopen(my $out, $destination, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600)
      or die "Refusing to create $destination: $!\n";
    my $buffer;
    while (read($in, $buffer, 65536)) { print {$out} $buffer or die "write $destination: $!\n"; }
    close($out) or die "close $destination: $!\n";
    close($in) or die "close $source: $!\n";
  ' "$source" "$destination"
}

snapshot_target() {
  local target=$1 snapshot
  reject_unsafe_target "$target" || return 1
  snapshot=$(random_sibling "$target" snapshot)
  if [[ -e $target ]]; then
    copy_nofollow "$target" "$snapshot" || return 1
  else
    printf '' | write_exclusive "$snapshot" || return 1
  fi
  printf '%s' "$snapshot"
}

backup_target() {
  local target=$1 backup
  reject_unsafe_target "$target" || return 1
  backup=$(random_sibling "$target" backup)
  copy_nofollow "$target" "$backup" || return 1
  printf '%s' "$backup"
}

atomic_replace() {
  local target=$1 candidate=$2
  reject_unsafe_target "$target" || return 1
  [[ -f $candidate && ! -L $candidate ]] || { printf 'Unsafe candidate: %s\n' "$candidate" >&2; return 1; }
  [[ $(dirname -- "$target") == "$(dirname -- "$candidate")" ]] \
    || { printf 'Candidate must be beside target: %s\n' "$candidate" >&2; return 1; }
  mv -fT -- "$candidate" "$target"
}

matches_target() {
  local target=$1 candidate=$2 snapshot result=1
  [[ -e $target ]] || return 1
  snapshot=$(snapshot_target "$target") || return 2
  cmp -s -- "$snapshot" "$candidate" && result=0
  rm -f -- "$snapshot"
  return "$result"
}

replace_managed() {
  local target=$1 candidate=$2 backup
  mkdir -p "$(dirname -- "$target")"
  reject_unsafe_target "$target" || return 1
  if [[ -f $target ]] && matches_target "$target" "$candidate"; then
    rm -f "$candidate"; printf 'OmaPets hooks already installed in %s\n' "$target"; return
  fi
  if [[ -f $target ]]; then
    backup=$(backup_target "$target") || return 1
    printf 'Backup: %s\n' "$backup"
  fi
  atomic_replace "$target" "$candidate"
  printf 'Installed OmaPets hooks in %s\n' "$target"
}

replace_after_uninstall() {
  local target=$1 candidate=$2 backup
  reject_unsafe_target "$target" || return 1
  if [[ ! -f $target ]] || matches_target "$target" "$candidate"; then
    rm -f "$candidate"; printf 'No OmaPets hooks found in %s\n' "$target"; return
  fi
  backup=$(backup_target "$target") || return 1
  atomic_replace "$target" "$candidate"
  printf 'Removed OmaPets hooks from %s\nBackup: %s\n' "$target" "$backup"
}

merge_grouped() {
  local target=$1 agent=$2 spec=$3 current candidate
  mkdir -p "$(dirname -- "$target")"
  current=$(snapshot_target "$target") || return 1
  candidate=$(random_sibling "$target" candidate)
  [[ -s $current ]] || printf '{}\n' | write_exclusive "${current}.json"
  if [[ ! -s $current ]]; then rm -f -- "$current"; current="${current}.json"; fi
  jq empty "$current" || { printf 'Invalid JSON: %s\n' "$target" >&2; return 1; }
  jq --arg command "$hook_command" --arg agent "$agent" --argjson spec "$spec" '
    reduce ($spec | to_entries[]) as $item (.;
      .hooks[$item.key] = ((.hooks[$item.key] // []) |
        if any(.[]; any(.hooks[]?; (.command // "") == ($command + " " + $item.value + " " + $agent)))
        then . else . + [{hooks:[{type:"command", command:($command + " " + $item.value + " " + $agent)}]}] end))
  ' "$current" | write_exclusive "$candidate"
  replace_managed "$target" "$candidate"; rm -f -- "$current"
}

install_codex() {
  local target="${CODEX_HOME:-$HOME/.codex}/config.toml" current candidate
  mkdir -p "$(dirname -- "$target")"
  current=$(snapshot_target "$target") || return 1
  if grep -Fq "$hook_command session-start codex" "$current"; then
    rm -f -- "$current"
    printf 'OmaPets hooks already installed in %s\n' "$target"; return
  fi
  candidate=$(random_sibling "$target" candidate)
  {
    cat -- "$current"
    printf '\n# BEGIN OMAPETS MANAGED HOOKS\n'
    while read -r hook event; do
      printf '\n[[hooks.%s]]\n[[hooks.%s.hooks]]\ntype = "command"\ncommand = "%s %s codex"\n' \
        "$hook" "$hook" "$hook_command" "$event"
    done <<'EOF'
SessionStart session-start
UserPromptSubmit prompt
PreToolUse tool-start
PostToolUse tool-end
PostToolUseFailure error
PermissionRequest permission
Stop stop
StopFailure error
SessionEnd session-end
EOF
    printf '# END OMAPETS MANAGED HOOKS\n'
  } | write_exclusive "$candidate"
  rm -f -- "$current"
  replace_managed "$target" "$candidate"
}

install_claude() {
  merge_grouped "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" claude \
    '{"SessionStart":"session-start","UserPromptSubmit":"prompt","PreToolUse":"tool-start","PostToolUse":"tool-end","PostToolUseFailure":"error","PermissionRequest":"permission","Stop":"stop","StopFailure":"error","SessionEnd":"session-end"}'
}

install_gemini() {
  merge_grouped "${GEMINI_CONFIG_DIR:-$HOME/.gemini}/settings.json" gemini \
    '{"SessionStart":"session-start","BeforeAgent":"prompt","BeforeTool":"tool-start","AfterTool":"tool-end","AfterAgent":"stop","Notification":"permission","SessionEnd":"session-end"}'
}

install_hook_file() {
  local target=$1 agent=$2 version=$3 events=$4 candidate
  mkdir -p "$(dirname -- "$target")"
  reject_unsafe_target "$target" || return 1
  candidate=$(random_sibling "$target" candidate)
  jq -n --arg cmd "$hook_command" --arg agent "$agent" --argjson events "$events" --argjson version "$version" '
    {hooks:($events | with_entries(.value=[{type:"command", command:($cmd + " " + .value + " " + $agent)}]))}
    | if $version == null then . else {version:$version} + . end
  ' | write_exclusive "$candidate"
  replace_managed "$target" "$candidate"
}

install_copilot() {
  install_hook_file "${COPILOT_HOME:-$HOME/.copilot}/hooks/omapets.json" copilot 1 \
    '{"sessionStart":"session-start","userPromptSubmitted":"prompt","preToolUse":"tool-start","postToolUse":"tool-end","permissionRequest":"permission","agentStop":"stop","errorOccurred":"error","sessionEnd":"session-end"}'
}

install_grok() {
  install_hook_file "${GROK_HOME:-$HOME/.grok}/hooks/omapets.json" grok null \
    '{"SessionStart":"session-start","UserPromptSubmit":"prompt","PreToolUse":"tool-start","PostToolUse":"tool-end","PostToolUseFailure":"error","PermissionDenied":"permission","Stop":"stop","StopFailure":"error","StopCancelled":"session-end","SessionEnd":"session-end"}'
}

install_crush() {
  local target="${CRUSH_CONFIG_DIR:-$HOME/.config/crush}/crush.json" current candidate
  mkdir -p "$(dirname -- "$target")"
  current=$(snapshot_target "$target") || return 1
  candidate=$(random_sibling "$target" candidate)
  [[ -s $current ]] || { rm -f -- "$current"; current=$(random_sibling "$target" current); printf '{}\n' | write_exclusive "$current"; }
  jq empty "$current" || { printf 'Invalid JSON: %s\n' "$target" >&2; return 1; }
  jq --arg command "$hook_command tool-start crush" '
    .hooks.PreToolUse=((.hooks.PreToolUse // []) | if any(.[];.command==$command) then . else .+[{name:"omarpets",command:$command}] end)
  ' "$current" | write_exclusive "$candidate"
  replace_managed "$target" "$candidate"; rm -f -- "$current"
}

install_opencode() {
  local target="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugins/omapets.js" candidate
  mkdir -p "$(dirname -- "$target")"
  reject_unsafe_target "$target" || return 1
  candidate=$(random_sibling "$target" candidate)
  sed "s|@HOOK@|$hook_command|g" <<'EOF' | write_exclusive "$candidate"
// Generated by OmaPets. managed-id: omapets-agent-hook-v1
export const OmaPets = async ({ $ }) => {
  const emit = async event => { await $`@HOOK@ ${event} opencode`.quiet() }
  return {
    event: async ({ event }) => {
      if (event.type === "session.created") await emit("session-start")
      else if (event.type === "session.status" && event.properties?.status?.type === "busy") await emit("prompt")
      else if (event.type === "permission.asked") await emit("permission")
      else if (event.type === "session.idle") await emit("stop")
      else if (event.type === "session.error") await emit("error")
      else if (event.type === "session.deleted") await emit("session-end")
    },
    "tool.execute.before": async () => { await emit("tool-start") },
    "tool.execute.after": async () => { await emit("tool-end") },
  }
}
EOF
  replace_managed "$target" "$candidate"
}

install_pi_extension() {
  local agent=$1 root target candidate
  [[ $agent == pi ]] && root="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}" || root="${OMP_AGENT_DIR:-$HOME/.omp/agent}"
  target="$root/extensions/omapets.ts"
  mkdir -p "$(dirname -- "$target")"
  reject_unsafe_target "$target" || return 1
  candidate=$(random_sibling "$target" candidate)
  sed -e "s|@HOOK@|$hook_command|g" -e "s|@AGENT@|$agent|g" <<'EOF' | write_exclusive "$candidate"
// Generated by OmaPets. managed-id: omapets-agent-hook-v1
import { spawn } from "node:child_process"
export default function (pi: any) {
  const emit = (event: string) => {
    const child = spawn("@HOOK@", [event, "@AGENT@"], { stdio:["pipe","ignore","ignore"] })
    child.stdin.end("{}")
  }
  pi.on("session_start", () => emit("session-start"))
  pi.on("before_agent_start", () => emit("prompt"))
  pi.on("tool_call", () => emit("tool-start"))
  pi.on("tool_result", () => emit("tool-end"))
  pi.on("agent_settled", () => emit("stop"))
  pi.on("session_shutdown", () => emit("session-end"))
}
EOF
  replace_managed "$target" "$candidate"
}

install_one() {
  case "$1" in
    codex) install_codex ;;
    claude|gemini|copilot|grok|crush|opencode) "install_$1" ;;
    pi|omp) install_pi_extension "$1" ;;
    oh-my-pi) install_pi_extension omp ;;
    *) printf 'Unsupported agent: %s\nSupported: %s\n' "$1" "${supported[*]}" >&2; return 2 ;;
  esac
}

uninstall_grouped() {
  local target=$1 agent=$2 spec=$3 current candidate
  reject_unsafe_target "$target" || return 1
  [[ -s $target ]] || { printf 'No OmaPets hooks found in %s\n' "$target"; return; }
  current=$(snapshot_target "$target") || return 1
  candidate=$(random_sibling "$target" candidate)
  jq --arg command "$hook_command" --arg agent "$agent" --argjson spec "$spec" '
    reduce ($spec | to_entries[]) as $item (.;
      if (.hooks[$item.key] | type) == "array" then
        .hooks[$item.key] |= [
          .[]
          | .hooks |= [ .[]? | select((.command // "") != ($command + " " + $item.value + " " + $agent)) ]
          | select((.hooks | length) > 0)
        ]
        | if (.hooks[$item.key] | length) == 0 then del(.hooks[$item.key]) else . end
      else . end)
    | if (.hooks | type) == "object" and (.hooks | length) == 0 then del(.hooks) else . end
  ' "$current" | write_exclusive "$candidate"
  rm -f -- "$current"
  replace_after_uninstall "$target" "$candidate"
}

uninstall_codex() {
  local target="${CODEX_HOME:-$HOME/.codex}/config.toml" current candidate
  reject_unsafe_target "$target" || return 1
  [[ -f $target ]] || { printf 'No OmaPets hooks found in %s\n' "$target"; return; }
  current=$(snapshot_target "$target") || return 1
  candidate=$(random_sibling "$target" candidate)
  OMAPETS_HOOK_COMMAND="$hook_command" perl -0pe '
    s/\n?# BEGIN OMAPETS MANAGED HOOKS\n.*?# END OMAPETS MANAGED HOOKS\n?//sg;
    s{\n?\[\[hooks\.[^\]\n]+\]\]\n\[\[hooks\.[^\]\n]+\.hooks\]\]\ntype = "command"\ncommand = "\Q$ENV{OMAPETS_HOOK_COMMAND}\E [^"\n]+ codex"\n?}{}g;
  ' "$current" | write_exclusive "$candidate"
  rm -f -- "$current"
  replace_after_uninstall "$target" "$candidate"
}

uninstall_claude() {
  uninstall_grouped "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" claude \
    '{"SessionStart":"session-start","UserPromptSubmit":"prompt","PreToolUse":"tool-start","PostToolUse":"tool-end","PostToolUseFailure":"error","PermissionRequest":"permission","Stop":"stop","StopFailure":"error","SessionEnd":"session-end"}'
}

uninstall_gemini() {
  uninstall_grouped "${GEMINI_CONFIG_DIR:-$HOME/.gemini}/settings.json" gemini \
    '{"SessionStart":"session-start","BeforeAgent":"prompt","BeforeTool":"tool-start","AfterTool":"tool-end","AfterAgent":"stop","Notification":"permission","SessionEnd":"session-end"}'
}

uninstall_hook_file() {
  local target=$1 agent=$2 current backup
  reject_unsafe_target "$target" || return 1
  [[ -f $target ]] || { printf 'No OmaPets hooks found in %s\n' "$target"; return; }
  current=$(snapshot_target "$target") || return 1
  if jq -e --arg command "$hook_command" --arg agent "$agent" '
    [.. | objects | .command? // empty] as $commands
    | ($commands | length) > 0
      and all($commands[]; startswith($command + " ") and endswith(" " + $agent))
  ' "$current" >/dev/null; then
    backup=$(backup_target "$target") || return 1
    reject_unsafe_target "$target" || return 1
    rm -f -- "$target"
    rm -f -- "$current"
    printf 'Removed OmaPets integration %s\nBackup: %s\n' "$target" "$backup"
  else
    rm -f -- "$current"
    printf 'Refusing to remove modified integration: %s\n' "$target" >&2
    return 1
  fi
}

uninstall_copilot() { uninstall_hook_file "${COPILOT_HOME:-$HOME/.copilot}/hooks/omapets.json" copilot; }
uninstall_grok() { uninstall_hook_file "${GROK_HOME:-$HOME/.grok}/hooks/omapets.json" grok; }

uninstall_crush() {
  local target="${CRUSH_CONFIG_DIR:-$HOME/.config/crush}/crush.json" current candidate command
  reject_unsafe_target "$target" || return 1
  [[ -s $target ]] || { printf 'No OmaPets hooks found in %s\n' "$target"; return; }
  current=$(snapshot_target "$target") || return 1
  candidate=$(random_sibling "$target" candidate); command="$hook_command tool-start crush"
  jq --arg command "$command" '
    if (.hooks.PreToolUse | type) == "array" then
      .hooks.PreToolUse |= [ .[] | select(.command != $command) ]
      | if (.hooks.PreToolUse | length) == 0 then del(.hooks.PreToolUse) else . end
      | if (.hooks | length) == 0 then del(.hooks) else . end
    else . end
  ' "$current" | write_exclusive "$candidate"
  rm -f -- "$current"
  replace_after_uninstall "$target" "$candidate"
}

remove_generated_file() {
  local target=$1 current backup
  reject_unsafe_target "$target" || return 1
  [[ -f $target ]] || { printf 'No OmaPets integration found at %s\n' "$target"; return; }
  current=$(snapshot_target "$target") || return 1
  if grep -Fq 'managed-id: omapets-agent-hook-v1' "$current" \
      || { grep -Fq "$hook_command" "$current" && grep -Eq 'OmaPets|session_start' "$current"; }; then
    backup=$(backup_target "$target") || return 1
    reject_unsafe_target "$target" || return 1
    rm -f -- "$target"
    rm -f -- "$current"
    printf 'Removed OmaPets integration %s\nBackup: %s\n' "$target" "$backup"
  else
    rm -f -- "$current"
    printf 'Refusing to remove modified integration: %s\n' "$target" >&2
    return 1
  fi
}

uninstall_opencode() { remove_generated_file "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugins/omapets.js"; }
uninstall_pi_extension() {
  local agent=$1 root
  [[ $agent == pi ]] && root="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}" || root="${OMP_AGENT_DIR:-$HOME/.omp/agent}"
  remove_generated_file "$root/extensions/omapets.ts"
}

uninstall_one() {
  case "$1" in
    codex) uninstall_codex ;;
    claude|gemini|copilot|grok|crush|opencode) "uninstall_$1" ;;
    pi|omp) uninstall_pi_extension "$1" ;;
    oh-my-pi) uninstall_pi_extension omp ;;
    *) printf 'Unsupported agent: %s\nSupported: %s\n' "$1" "${supported[*]}" >&2; return 2 ;;
  esac
}

if (( interactive )); then
  status=0
  choose_interactive_targets || status=$?
  if (( status == 0 )); then
    for target in "${targets[@]}"; do
      "${action}_one" "$target" || status=1
    done
  fi
  finish_interactive "$status"
  exit "$status"
fi

[[ ${targets[0]} == all ]] && targets=("${supported[@]}")
for target in "${targets[@]}"; do "${action}_one" "$target"; done
