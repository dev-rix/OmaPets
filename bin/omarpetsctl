#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: omarpetsctl <idle|working|waiting|success|error|refresh> [detail]\n' >&2
}

state="${1:-}"
case "$state" in
  idle|working|waiting|success|error)
    shift
    exec omarchy-shell wei.omarpets "$state" "${*:-}"
    ;;
  refresh)
    exec omarchy-shell wei.omarpets refresh
    ;;
  *)
    usage
    exit 2
    ;;
esac
