#!/usr/bin/env bash
set -euo pipefail

window="${1:?activity window is required}"
home="${2:?home directory is required}"
# "auto" adds heuristic inference; "hooks" reports only saved hook status.
mode="${3:-auto}"

agent=$(omarchy-default-agent 2>/dev/null || true)
if [[ ! $agent =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
  printf ':inactive'
  exit 0
fi

state_home="${XDG_STATE_HOME:-$home/.local/state}"
status_file="$state_home/omarchy/omapets/agents/$agent.json"
if [[ -f "$status_file" ]]; then
  hook_state=$(jq -r '.state // empty' "$status_file" 2>/dev/null || true)
  hook_time=$(jq -r '(.updatedAtEpoch | tonumber?) // 0' "$status_file" 2>/dev/null || printf 0)
  age=$(($(date +%s) - hook_time))
  # A saved hook state stands until the agent's next hook event replaces it,
  # so a finished turn is not later guessed to be waiting on the user.
  max_age=14400
  if [[ -n "$hook_state" && $age -ge 0 && $age -le $max_age ]]; then
    printf '%s:%s' "$agent" "$hook_state"
    exit 0
  fi
fi

if [[ "$mode" == hooks ]]; then
  printf '%s:inactive' "$agent"
  exit 0
fi

case "$agent" in
  codex) activity_dir="${CODEX_HOME:-$home/.codex}/sessions" ;;
  claude) activity_dir="${CLAUDE_CONFIG_DIR:-$home/.claude}/projects" ;;
  *) activity_dir= ;;
esac

recent=0
if [[ -n "$activity_dir" && -d "$activity_dir" ]] \
    && find "$activity_dir" -type f -newermt "$window seconds ago" -print -quit 2>/dev/null | grep -q .; then
  recent=1
fi

printf '%s:' "$agent"
if [[ $recent -eq 1 ]]; then
  printf working
elif pgrep -f "(^|/)$agent( |$)" >/dev/null 2>&1; then
  # Without hooks, a quiet open agent may be done or may be waiting on the user.
  printf attention
else
  printf inactive
fi
